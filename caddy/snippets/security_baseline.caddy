(security_baseline) {
  header {
    -Server
    -X-Powered-By

    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  @sensitiveRoutes path /auth* /proxy/auth* /login* /signin* /account* /phpmyadmin*
  header @sensitiveRoutes {
    Cache-Control "no-store"
    Pragma "no-cache"
  }

  @vcs path /.git* /.hg* /.svn* /.DS_Store
  respond @vcs 403

  # Block traversal segments, but allow legitimate filenames containing `..`
  # such as Next.js/Turbopack chunks (`chunk..js`).
  @dotdot path_regexp dotdot (?i)(^|/)(\.\.|%2e%2e|%252e%252e|%c0%ae%c0%ae|%uff0e%uff0e)(/|$)|(^|/)(%2e%2f|%2f%2e|%5c%2e%2e|%2e%2e%5c)(/|$)
  respond @dotdot 400
}
