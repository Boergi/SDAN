(security_baseline) {
  header {
    -Server
    -X-Powered-By

    # Transport & Browser-Härtung
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # CSP: lokale Assets, inline erlaubt, WS ok, Images von überall via https + data
    Content-Security-Policy "default-src 'self'; \
      style-src 'self' 'unsafe-inline'; \
      script-src 'self' 'unsafe-inline' 'unsafe-eval'; \
      img-src 'self' data: https:; \
      font-src 'self' data:; \
      connect-src 'self' wss: https://login.microsoftonline.com https://*.microsoftonline.com https://graph.microsoft.com; \
      media-src 'self'; \
      base-uri 'none'; object-src 'none'; \
      frame-ancestors 'self'; \
      form-action 'self' https://login.microsoftonline.com"
  }

  # Sensitive Endpoints: kein Caching
  @sensitiveRoutes path /auth* /login* /signin* /account* /phpmyadmin*
  header @sensitiveRoutes {
    Cache-Control "no-store"
    Pragma "no-cache"
  }

  # Versteckte/VCS-Dateien blocken
  @vcs path /.git* /.hg* /.svn* /.DS_Store
  respond @vcs 403

  # Path-Traversal inkl. encodeter Varianten blocken
  @dotdot path_regexp dotdot (?i)(\.\.|%2e%2e|%252e%252e|%c0%ae%c0%ae|%uff0e%uff0e|%2e%2f|%2f%2e|%5c%2e%2e|%2e%2e%5c)
  respond @dotdot 400
}