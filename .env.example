# OpenID Provider Configuration
# ==============================
#
# Choose one provider and configure it:
#
# 1. Azure AD (Microsoft Entra ID):
#    - Set OIDC_PROVIDER=azure
#    - Fill in AZURE_* values
#
# 2. Authentik:
#    - Set OIDC_PROVIDER=authentik
#    - Fill in AUTHENTIK_* values
#
# 3. No SSO (IP + Token only):
#    - Set OIDC_PROVIDER=none
#    - No other credentials needed
#
# For all providers:
#    AUTH_DOMAIN: The hostname for the SSO portal (e.g., auth.yourdomain.com)
#    COOKIE_DOMAIN: The domain for cookies (e.g., yourdomain.com)
#    PROXY_NETWORK: The Docker network name (default: swag_proxy_net)

OIDC_PROVIDER=none

# Azure AD (Microsoft Entra ID)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Authentik
AUTHENTIK_ISSUER_URL=https://your-authentik-domain/application/service/authentik/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Common settings
AUTH_DOMAIN=auth.yourdomain.com
COOKIE_DOMAIN=yourdomain.com
PROXY_NETWORK=proxy_net

# Additional Caddy plugins (space-separated --with flags for xcaddy build)
# Example: --with github.com/mholt/caddy-ratelimit
CADDY_PLUGINS=
